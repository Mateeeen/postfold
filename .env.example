# Third-party API that drives LinkedIn on the user's behalf.
# Leave UNIPILE_API_KEY unset to run entirely on the FakeProvider: nothing is
# sent anywhere, and the composer, carousel, suggestions, approval flow, paced
# queue and worker all still work end to end.
# Your tenant DSN from the Unipile dashboard. Includes a port; it is NOT
# https://api.unipile.com.
UNIPILE_BASE_URL=https://apiXX.unipile.com:1XXXX
UNIPILE_API_KEY=
UNIPILE_WEBHOOK_SECRET=dev-webhook-secret

# SQLite file. WAL mode, single writer.
DATABASE_PATH=./data/postfold.db

PORT=3000

# Single-user build. See src/http/auth.ts for the TODO.
SINGLE_USER_ID=user_local

# Text drafting. Any OpenAI-compatible chat-completions endpoint works; the
# adapter is src/llm/groq.ts. Leave LLM_API_KEY unset to run on FakeLlm:
# drafts are deterministic placeholders, no credits are spent, and the whole
# draft -> approve -> queue -> publish loop still works end to end.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
